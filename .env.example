# Copy to .env for local runs. .env is gitignored — never commit real values.
# In GitHub Actions these are supplied as repository secrets instead of a file.

# ── Data ──────────────────────────────────────────────────────────
DATA_DIR=./data

# ── SMTP (send-report) ────────────────────────────────────────────
# iCloud: host smtp.mail.me.com, port 587. SMTP_PASSWORD must be an
# app-specific password (appleid.apple.com → Sign-In and Security →
# App-Specific Passwords), not your normal Apple password. EMAIL_FROM
# must match the iCloud account or a verified alias.
SMTP_HOST=smtp.mail.me.com
SMTP_PORT=587
SMTP_USER=you@me.com
SMTP_PASSWORD=xxxx-xxxx-xxxx-xxxx
EMAIL_FROM=you@me.com

# Monthly-report recipients. In CI this is the MANAGER_EMAILS secret. Accepts
# the "name,email" CSV text of that secret, or a plain comma/newline-separated
# list of addresses. Leave blank locally and use SEND_TEST_ONLY instead.
MANAGER_EMAILS=

# Local testing: send only to yourself, ignoring MANAGER_EMAILS.
SEND_TEST_ONLY=false
TEST_EMAIL=you@me.com

# ── Logging ───────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── FPL API ───────────────────────────────────────────────────────
FPL_BASE_URL=https://fantasy.premierleague.com/api
